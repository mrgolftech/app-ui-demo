{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Rainbow Bookshelf / 彩虹书架",
  "version": "1.0.0",
  "status": "working-brand-reference",
  "colors": {
    "coral": "#FF4562",
    "orange": "#FF9B2E",
    "yellow": "#FFD33F",
    "green": "#49CE85",
    "sky": "#159EF7",
    "purple": "#714EFF",
    "brandText": "#17235B",
    "surface": "#F4F8FF",
    "surfaceDark": "#081334",
    "white": "#FFFFFF"
  },
  "clearSpace": {
    "unit": "symbolWidth",
    "minimum": 0.1
  },
  "sizes": {
    "recommendedMinLogoPx": 64,
    "faviconUsesSimplifiedSymbol": true,
    "androidAdaptiveCentralSafeZoneDp": 66,
    "androidAdaptiveCanvasDp": 108
  },
  "fontStack": [
    "Noto Sans SC",
    "Noto Sans CJK SC",
    "Microsoft YaHei",
    "sans-serif"
  ],
  "assetRoots": {
    "editable": "brand/src",
    "generated": "brand/dist",
    "publishedWebTarget": "public/brand"
  },
  "usage": {
    "logoMark": "graphical only; A/B/C allowed",
    "wordmark": "only when enough room",
    "android": "use app-icon tile and adaptive foreground; avoid extra round-corner masks in source"
  }
}

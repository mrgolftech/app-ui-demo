{
  "name": "app-ui-demo",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Child-first landscape visual acceptance demo in React + Capacitor",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:visual": "node tests/visual-audit.mjs",
    "android:init": "npx cap add android",
    "android:sync": "npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "8.0.0",
    "@capacitor/core": "8.0.0",
    "@capacitor/app": "8.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.9.0",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.0.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.1.11",
    "playwright": "1.57.0"
  }
}
